---
import Shot from './Shot.astro';

const demo = 'https://delivest-client.shafranov.tech';
const phoneScreens = [
  { name: 'client-menu', alt: 'Витрина с акциями и меню' },
  { name: 'client-product', alt: 'Карточка товара' },
  { name: 'client-cart', alt: 'Корзина с промокодом' },
  { name: 'client-checkout', alt: 'Оформление заказа' },
];
const toasts = [
  { tone: 'accent', title: 'Новый заказ №1024', sub: '1 417 ₽ · самовывоз к 12:30' },
  { tone: 'gold', title: 'Промокод BREAK', sub: 'скидка 15% применена' },
  { tone: 'ok', title: 'Передан во Frontpad', sub: 'заказ №1024 на кухне' },
  { tone: 'ok', title: 'Статус: готовится', sub: 'гость видит его на сайте' },
];
---
<div class="hero">
  <div class="wrap grid">
    <div class="copy">
      <span class="kicker reveal">Онлайн-заказы для кафе и ресторанов</span>
      <h1 class="reveal" style="--d:1">Собственная доставка <em>под вашим брендом</em></h1>
      <p class="lead reveal" style="--d:2">Сайт для заказов, панель для персонала и интеграция с CRM. Работает на вашем домене и в ваших цветах, без комиссий агрегаторов.</p>
      <div class="cta reveal" style="--d:3">
        <a class="btn btn-ink" href={demo} target="_blank" rel="noopener">Открыть демо ↗</a>
        <a class="btn btn-line" href="#contacts">Обсудить подключение</a>
      </div>
      <p class="note reveal" style="--d:4"><span class="live"></span>Демо работает круглосуточно</p>
    </div>

    <div class="stage reveal" style="--d:2">
      <div class="browser">
        <div class="browser-bar"><i></i><i></i><i></i><span class="url">delivest-client.shafranov.tech</span></div>
        <Shot name="client-desktop" alt="Клиентский сайт на компьютере" widths={[700, 1100, 1686]} sizes="(max-width: 1020px) 92vw, 560px" />
      </div>
      <div class="float">
        <div class="phone">
          <div class="screens" data-cycle="3200">
            {phoneScreens.map((s, i) => (
              <div class:list={['scr', i === 0 && 'on']}><Shot {...s} widths={[260, 400]} sizes="200px" /></div>
            ))}
          </div>
        </div>
      </div>
      <div class="toasts" aria-hidden="true">
        {toasts.map((t, i) => (
          <div class:list={['toast', i === 0 && 'on']} data-tone={t.tone}><i></i><div><b>{t.title}</b><span>{t.sub}</span></div></div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .hero { padding: clamp(40px, 7vw, 84px) 0 clamp(48px, 6vw, 72px); overflow: hidden; }
  .grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .lead { font-size: clamp(17px, 1.6vw, 20px); color: var(--ink-2); max-width: 32em; margin: 0 0 32px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .note { margin: 22px 0 0; font-size: 14px; color: var(--muted); display: flex; gap: 10px; align-items: center; }
  .live { width: 8px; height: 8px; border-radius: 50%; background: #3AA66B; position: relative; flex: none; }
  .live::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: #3AA66B; animation: ping 2s ease-out infinite; }
  @keyframes ping { to { transform: scale(3); opacity: 0; } }

  .stage { position: relative; padding: 0 64px 48px 0; }
  .float { position: absolute; right: 0; bottom: 0; width: 34%; max-width: 200px; transform: rotate(3deg); }
  .float .phone { animation: bob 6s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(-8px); } }

  .toasts { position: absolute; left: -24px; bottom: 18px; width: 250px; height: 64px; }
  .toast {
    position: absolute; inset: 0; display: flex; gap: 12px; align-items: center;
    padding: 12px 16px; border-radius: 14px; background: var(--card); border: 1.5px solid var(--edge);
    box-shadow: 0 18px 40px -18px rgba(42, 0, 7, .45);
    opacity: 0; transform: translateY(14px) scale(.96);
    transition: opacity .45s var(--ease), transform .45s var(--ease);
  }
  .toast.on { opacity: 1; transform: none; }
  .toast i { width: 10px; height: 10px; border-radius: 50%; flex: none; background: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent); }
  .toast[data-tone="gold"] i { background: var(--gold); box-shadow: 0 0 0 4px color-mix(in srgb, var(--gold) 22%, transparent); }
  .toast[data-tone="ok"] i { background: var(--ok); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 20%, transparent); }
  .toast b { display: block; font-size: 14px; line-height: 1.3; }
  .toast span { display: block; font-size: 12.5px; color: var(--muted); line-height: 1.3; }

  @media (max-width: 1020px) {
    .grid { grid-template-columns: 1fr; }
    .stage { max-width: 640px; }
  }
  @media (max-width: 720px) {
    .stage { padding: 0 36px 40px 0; }
    .toasts { left: -6px; bottom: 6px; width: 210px; height: 58px; }
    .toast { padding: 10px 12px; }
  }
</style>

<script>
  // Rotates children with .on inside every [data-cycle] / toast stack; pauses off-screen and in background tabs
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rotate = (items: Element[], ms: number, box: Element) => {
    if (calm || items.length < 2) return;
    let i = 0, visible = false;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(box);
    setInterval(() => {
      if (!visible || document.hidden) return;
      items[i].classList.remove('on');
      i = (i + 1) % items.length;
      items[i].classList.add('on');
    }, ms);
  };
  document.querySelectorAll<HTMLElement>('.hero [data-cycle]').forEach(el => rotate([...el.children], +el.dataset.cycle!, el));
  const toasts = document.querySelector('.hero .toasts');
  if (toasts) rotate([...toasts.children], 2600, toasts);
</script>
