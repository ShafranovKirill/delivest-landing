---
import Shot from './Shot.astro';
const steps = [
  {title: 'Гость оформляет заказ', text: 'Выбирает блюда, указывает адрес и способ оплаты. Акции применяются при оформлении.', shot: 'client-checkout', link: '#app'},
  {title: 'Оператор принимает', text: 'Новые заказы появляются в общей ленте. Оператор проверяет состав и передаёт заказ в работу.', shot: 'admin-orders', link: '#admin'},
  {title: 'Команда выполняет', text: 'Статусы помогают следить за выполнением. Интеграция передаёт заказ в подключённую CRM.', shot: 'admin-frontpad', link: '#crm'},
  {title: 'Гость возвращается', text: 'Акции и персональные промокоды дают повод заказать снова. История покупок остаётся в карточке клиента.', shot: 'admin-client', link: '#promo'},
];
---
<section id="workflow" class="tinted">
  <div class="wrap">
    <div class="head reveal">
      <span class="kicker">Как это работает</span>
      <h2>От первого заказа <em>до следующего</em></h2>
      <p>Посмотрите, что видит гость и как с его заказом работает команда.</p>
    </div>
    <div class="journey-grid">
      {steps.map((step, i) => <article class="journey-card reveal">
        <div class="journey-copy"><span class="kicker">0{i + 1}</span><h3>{step.title}</h3><p>{step.text}</p><a href={step.link}>Подробнее <span aria-hidden="true">↓</span></a></div>
        <Shot name={step.shot} alt={step.title} widths={[400, 700]} sizes="(max-width: 700px) 90vw, 42vw" />
      </article>)}
    </div>
    <div class="operations">
      <article><h3>Экран кухни</h3><p>Повар видит заказы в работе и отмечает готовность. Оператор видит статус кухни и задержки.</p></article>
      <article><h3>Работа курьера</h3><p>Назначение доставки и статусы от получения заказа до передачи гостю — в рабочем интерфейсе курьера.</p></article>
      <article><h3>Бонусная программа</h3><p>Начисляйте звёзды за выполненные заказы, задавайте бонусную стоимость блюд и предлагайте гостям товары за звёзды.</p></article>
    </div>
    <div class="journey-demo"><p>Попробуйте путь гостя самостоятельно — от меню до оформления.</p><a class="btn btn-ink" href="https://delivest-client.shafranov.tech" target="_blank" rel="noopener">Открыть живое демо ↗</a><button class="btn btn-line" type="button" data-lead>Запросить показ панели</button></div>
  </div>
</section>
<style>
.operations{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:32px}.operations article{border-top:2px solid var(--edge);padding-top:20px}.operations h3{font-size:21px;margin:0 0 12px}.operations p{line-height:1.6}.journey-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.journey-card{overflow:hidden;border:1px solid var(--edge);border-radius:24px;background:var(--paper)}.journey-copy{padding:28px}.journey-copy h3{font-size:24px;margin:12px 0}.journey-copy p{line-height:1.6;margin:0 0 16px}.journey-copy a{color:inherit;text-underline-offset:4px}.journey-card :global(img){display:block;width:100%;height:280px;object-fit:contain;object-position:top;background:var(--paper)}.journey-demo{display:flex;justify-content:center;align-items:center;gap:16px;flex-wrap:wrap;margin-top:32px}.journey-demo p{width:100%;text-align:center}@media(max-width:700px){.operations{grid-template-columns:1fr}.journey-grid{grid-template-columns:1fr}.journey-copy{padding:22px}.journey-card :global(img){height:240px}}
</style>
