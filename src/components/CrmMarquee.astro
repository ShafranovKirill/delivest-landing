---
import { Image } from 'astro:assets';
import frontpad from '../assets/crm/frontpad.webp';
import iiko from '../assets/crm/iiko.webp';
import rkeeper from '../assets/crm/rkeeper.webp';
import poster from '../assets/crm/poster.webp';
import onec from '../assets/crm/1c.webp';
import saby from '../assets/crm/saby.svg';

// Only Frontpad is integrated today; the rest are offered on request and must read that way
const systems = [
  { name: 'Frontpad', logo: frontpad, live: true },
  { name: 'iiko', logo: iiko },
  { name: 'r_keeper', logo: rkeeper },
  { name: 'Poster', logo: poster },
  { name: 'Saby', logo: saby },
  { name: '1С', logo: onec },
];
// Two copies of the row make the -50% loop seamless
const rows = [0, 1];
---
<div class="strip">
  <div class="wrap label">
    <span>Работает с учётными системами</span>
    <span class="legend"><i class="dot live"></i>подключено <i class="dot"></i>по запросу</span>
  </div>
  <div class="marquee">
    <div class="track">
      {rows.map(copy => systems.map(s => (
        <div class:list={['chip', s.live && 'live']} aria-hidden={copy ? 'true' : undefined}>
          <Image src={s.logo} alt="" width={32} height={32} densities={[1, 2]} />
          <b>{s.name}</b>
          <span>{s.live ? 'подключено' : 'по запросу'}</span>
        </div>
      )))}
    </div>
  </div>
</div>

<style>
  .strip { border-block: 1.5px solid var(--edge); padding: 18px 0 22px; background: var(--paper); }
  .label { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 14px; }
  .legend { display: inline-flex; align-items: center; gap: 6px; text-transform: none; letter-spacing: 0; }
  .legend .dot:nth-of-type(2) { margin-left: 10px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line); display: inline-block; }
  .dot.live { background: var(--ok); }

  .marquee { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .track { display: flex; gap: 14px; width: max-content; animation: slide 36s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(calc(-50% - 7px)); } }

  .chip { display: flex; align-items: center; gap: 12px; padding: 10px 18px 10px 10px; border-radius: 16px; border: 1px solid var(--line); background: var(--card); white-space: nowrap; }
  .chip img { width: 32px; height: 32px; border-radius: 8px; object-fit: contain; filter: grayscale(1); opacity: .6; transition: filter .3s, opacity .3s; }
  .chip:hover img { filter: none; opacity: 1; }
  .chip b { font-size: 16px; font-weight: 600; color: var(--ink-2); }
  .chip span { font-size: 12.5px; color: var(--muted); }
  .chip.live { border: 1.5px solid var(--ok); }
  .chip.live img { filter: none; opacity: 1; }
  .chip.live b { color: var(--ink); }
  .chip.live span { color: var(--ok); font-weight: 600; }
  .chip.live span::before { content: ""; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--ok); margin-right: 6px; vertical-align: 1px; animation: blink 2s ease-in-out infinite; }
  @keyframes blink { 50% { opacity: .35; } }
</style>
