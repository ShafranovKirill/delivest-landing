---
import { Image } from 'astro:assets';
import frontpad from '../assets/crm/frontpad.webp';
import iiko from '../assets/crm/iiko.webp';
import rkeeper from '../assets/crm/rkeeper.webp';
import poster from '../assets/crm/poster.webp';
import onec from '../assets/crm/1c.webp';
import saby from '../assets/crm/saby.svg';

const systems = [
  { name: 'iiko', logo: iiko },
  { name: 'r_keeper', logo: rkeeper },
  { name: 'Frontpad', logo: frontpad },
  { name: 'Poster', logo: poster },
  { name: 'Saby', logo: saby },
  { name: '1С', logo: onec },
];
// Two copies of the row make the -50% loop seamless
const rows = [0, 1];
---
<div class="strip">
  <div class="wrap label">Подключаемся к вашей CRM</div>
  <div class="marquee">
    <div class="track">
      {rows.map(copy => [
        ...systems.map(s => (
          <div class="chip" aria-hidden={copy ? 'true' : undefined}>
            <Image src={s.logo} alt="" width={32} height={32} densities={[1, 2]} />
            <b>{s.name}</b>
          </div>
        )),
        <div class="chip more" aria-hidden={copy ? 'true' : undefined}><span class="plus">+</span><b>ваша CRM</b></div>,
      ])}
    </div>
  </div>
</div>

<style>
  .strip { border-block: 1.5px solid var(--edge); padding: 18px 0 22px; background: var(--paper); }
  .label { font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 14px; }

  .marquee { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .track { display: flex; gap: 14px; width: max-content; animation: slide 36s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(calc(-50% - 7px)); } }

  .chip { display: flex; align-items: center; gap: 12px; padding: 10px 20px 10px 10px; border-radius: 16px; border: 1px solid var(--line); background: var(--card); white-space: nowrap; transition: border-color .3s; }
  .chip img { width: 32px; height: 32px; border-radius: 8px; object-fit: contain; filter: grayscale(1); opacity: .65; transition: filter .3s, opacity .3s; }
  .chip:hover { border-color: var(--accent); }
  .chip:hover img { filter: none; opacity: 1; }
  .chip b { font-size: 16px; font-weight: 600; color: var(--ink-2); }
  .chip.more { border-style: dashed; }
  .plus { width: 32px; height: 32px; border-radius: 8px; display: grid; place-items: center; background: var(--paper-2); color: var(--accent); font-size: 20px; font-weight: 600; }
</style>
