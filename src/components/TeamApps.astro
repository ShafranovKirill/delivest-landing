---
const apps = [
 { n: '01', role: 'Курьерам', title: 'Заказ — с собой', text: 'Встроенное приложение для ваших курьеров. Рабочее место доставщика всегда под рукой.', steps: ['Заказ', 'Доставка', 'Гость'] },
 { n: '02', role: 'Кухне', title: 'Время готовить', text: 'Приложение для кухни помогает команде работать с поступившими заказами и их приготовлением.', steps: ['Новый заказ', 'Готовится', 'Готов'] },
 { n: '03', role: 'Гостям', title: 'Готовность на виду', text: 'Табло вывода заказов для вашего заведения: гость видит, когда можно забирать свой заказ.', steps: ['Заказ № 024', 'Готовится', 'Можно забирать'] },
];
---
<section id="team" class="tinted"><div class="wrap">
 <div class="head"><span class="kicker">Приложения для команды</span><h2>Гость оформил заказ.<br/><em>Команда знает, что дальше.</em></h2><p>Продолжите путь заказа внутри ресторана: приготовление на кухне, работа курьера и готовность на табло. Для каждой роли — свой рабочий экран.</p></div>
 <div class="team-grid">{apps.map(app=><article><div class="label"><span>{app.role}</span><span>{app.n}</span></div><h3>{app.title}</h3><p>{app.text}</p><ol aria-label={`Пример сценария: ${app.role.toLowerCase()}`}>{app.steps.map(step=><li>{step}</li>)}</ol></article>)}</div>
</div></section>
<style>
.team-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.team-grid article{display:flex;flex-direction:column;padding:28px;background:var(--card);border:1px solid var(--line);border-radius:24px}.label{display:flex;justify-content:space-between;color:var(--accent);font-size:13px;letter-spacing:.06em;text-transform:uppercase;margin-bottom:32px}.team-grid h3{font-size:28px}.team-grid p{color:var(--ink-2);font-size:16px;margin-bottom:28px}.team-grid ol{margin:auto 0 0;padding:20px 0 0;list-style:none;border-top:1px solid var(--line);display:flex;flex-wrap:wrap;gap:8px}.team-grid li{font-size:12px;padding:6px 10px;border-radius:8px;background:var(--paper-2);color:var(--ink-2)}.team-grid li:last-child{background:var(--brand);color:var(--on-night)}@media(max-width:850px){.team-grid{grid-template-columns:1fr}.label{margin-bottom:20px}}
</style>
