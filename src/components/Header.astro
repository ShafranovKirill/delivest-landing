---
import logo from '../assets/brand/logo-horizontal.svg?raw';

// The brand file has fixed fills; strip them so the logo follows the theme colour
const mark = logo
  .replaceAll(' fill="#48010c"', '')
  .replace(' width="1518" height="352"', ' class="logo-full" role="img" aria-label="Delivest"');
const demo = 'https://delivest-client.shafranov.tech/kovrov';
---
<header class="top" id="site-header">
  <div class="wrap">
    <a class="logo" href="#top" set:html={mark} />
    <nav class="nav" id="site-nav" aria-label="Основная навигация">
      <a href="#app">Для гостей</a>
      <a href="#management">Для бизнеса</a>
      <a href="#integrations">Интеграции</a>
      <a href="#launch">Подключение</a>
      <a class="nav-demo" href={demo} target="_blank" rel="noopener">Демо-сайт ↗</a>
    </nav>
    <button class="theme-btn" type="button" data-theme-toggle aria-label="Переключить тему" title="Светлая / тёмная тема">
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"/></svg>
    </button>
    <button class="btn btn-ink btn-sm header-cta" type="button" data-lead="demo"><span class="long">Получить демо</span><span class="short">Демо</span></button>
    <button class="menu-btn" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path class="menu-lines" d="M4 7h16M4 12h16M4 17h16"/><path class="menu-cross" d="m6 6 12 12M18 6 6 18"/></svg>
    </button>
  </div>
</header>

<style>
  .top {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color .2s;
  }
  .top.scrolled { border-bottom-color: var(--line); }
  .wrap { display: flex; align-items: center; gap: 20px; min-height: 72px; position: relative; }
  .logo { display: flex; color: var(--brand); flex: none; }
  :global(:root[data-theme="dark"]) .logo { color: var(--ink); }
  .logo :global(.logo-full) { height: 28px; width: auto; fill: currentColor; }
  .nav { display: flex; align-items: center; gap: 22px; margin-left: auto; font-size: 15px; }
  .nav a { white-space: nowrap; text-decoration: none; color: var(--ink-2); position: relative; }
  .nav a::after { content: ""; position: absolute; left: 0; right: 0; bottom: -4px; height: 1.5px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .25s var(--ease); }
  .nav a:hover { color: var(--ink); }
  .nav a:hover::after { transform: none; }
  .theme-btn { width: 40px; height: 40px; flex: none; display: grid; place-items: center; border-radius: 50%; border: 1.5px solid var(--edge); background: transparent; cursor: pointer; transition: background .15s, color .15s; }
  .theme-btn:hover { background: var(--ink); color: var(--paper); }
  .theme-btn svg { width: 18px; height: 18px; }
  .moon, :global(:root[data-theme="dark"]) .sun { display: none; }
  :global(:root[data-theme="dark"]) .moon { display: block; }
  .header-cta { flex: none; white-space: nowrap; }
  .menu-btn { display: none; }
  .nav-demo { color: var(--accent); }
  .short { display: none; }
  @media (max-width: 1100px) {
    .wrap { gap: 12px; }
    .theme-btn { margin-left: auto; }
    .nav { display: none; position: absolute; top: 100%; left: var(--gutter); right: var(--gutter); margin: 0; padding: 12px; background: var(--card); border: 1px solid var(--line); border-radius: 0 0 20px 20px; box-shadow: 0 16px 32px #2a000718; }
    .nav.open { display: grid; gap: 0; }
    .nav a { padding: 12px 14px; border-radius: 10px; }
    .nav a:hover { background: var(--paper-2); }
    .nav a::after { display: none; }
    .menu-btn { display: grid; place-items: center; width: 40px; height: 40px; flex: none; padding: 0; border: 1px solid var(--line); border-radius: 50%; background: transparent; cursor: pointer; }
    .menu-btn svg { width: 20px; height: 20px; }
    .menu-cross, .menu-btn[aria-expanded="true"] .menu-lines { display: none; }
    .menu-btn[aria-expanded="true"] .menu-cross { display: block; }
  }
  @media (max-width: 560px) {
    .wrap { gap: 8px; min-height: 64px; }
    .logo :global(.logo-full) { width: 104px; height: auto; }
    .theme-btn, .menu-btn { width: 36px; height: 36px; }
    .header-cta { padding: 0 12px; }
  }
  @media (max-width: 380px) {
    .long { display: none; }
    .short { display: inline; }
    .logo :global(.logo-full) { width: 96px; }
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const nav = header.querySelector<HTMLElement>('.nav')!;
  const setMenu = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
    nav.classList.toggle('open', open);
  };
  toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  header.querySelectorAll('a, [data-lead]').forEach(el => el.addEventListener('click', () => setMenu(false)));
  document.addEventListener('click', e => { if (!header.contains(e.target as Node)) setMenu(false); });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { setMenu(false); toggle.focus(); }
  });
  matchMedia('(min-width: 1101px)').addEventListener('change', () => setMenu(false));
  const syncHeader = () => header.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', syncHeader, { passive: true });
  syncHeader();
</script>
