---
const faq = [
  ['У нас уже есть агрегаторы. Зачем свой сайт?', 'Это ещё один канал заказов — под вашим брендом. Ссылку можно разместить в соцсетях, рекламе, на упаковке или в самом заведении. Гость приходит к вам напрямую, а бонусы и акции дают повод вернуться. При этом вы можете продолжать работать с агрегаторами.'],
  ['Откуда на сайте появятся гости?', 'Сайт принимает заказы, но сам по себе не заменяет продвижение. Направляйте на него гостей из своих соцсетей, рекламы и офлайн-точек. В Delivest есть промокоды, подарки и бонусные звёзды, чтобы поддержать первое знакомство и повторные покупки.'],
  ['Нужно скачивать приложение?', 'Нет. Гость открывает сайт по ссылке в браузере телефона или компьютера. Меню, корзина, доставка и самовывоз доступны на вашем сайте.'],
  ['Подойдёт для нескольких заведений?', 'Да. Для филиалов можно настроить отдельные меню, цены и часы работы. Сотрудникам выдаются доступы к нужным точкам. На демонстрации разберём, как организовать работу вашей сети.'],
  ['Нужно менять нашу ресторанную систему?', 'В Delivest предусмотрены интеграции с Frontpad, iiko и r_keeper. До запуска обсудим вашу систему, нужные подключения и условия их работы. Состав интеграций согласуем для вашего заведения.'],
  ['Сколько стоит подключение и что входит?', 'Стоимость рассчитываем по количеству точек, нужным интеграциям и объёму запуска. Обсудим подготовку сайта, перенос меню, обучение и дальнейшую работу. Оплату сторонних сервисов проговорим отдельно.'],
  ['Когда можно начать принимать заказы?', 'Срок зависит от готовности меню, оформления и подключаемых сервисов. После обсуждения задачи согласуем план запуска. Перед стартом проверим путь заказа и подготовим сотрудников к работе.'],
];
---
<section id="faq">
  <div class="wrap">
    <div class="head"><span class="kicker">Перед решением</span><h2>То, что важно<br/><em>до подключения.</em></h2></div>
    <div class="faq">{faq.map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
  </div>
</section>
<style>
  .faq { max-width: 900px; }
  details { border-bottom: 1px solid var(--line); padding: 22px 0; }
  summary { cursor: pointer; font-size: 20px; font-weight: 600; }
  details p { max-width: 720px; color: var(--ink-2); margin-bottom: 0; }
  @media (max-width: 500px) { summary { font-size: 18px; } }
</style>
